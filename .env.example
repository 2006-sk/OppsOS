# ============================================================================
# Opportunity OS — environment variables
# Copy this file to apps/web/.env.local and apps/scraper/.env, then fill in.
# Never commit real values. See README.md for full setup instructions.
# ============================================================================

# --- Database (Turso/libSQL, used by BOTH apps) -----------------------------
# Create a database at turso.tech (or via the turso CLI), then set both:
# Use the libsql:// form here — the web app's Prisma adapter needs it, and
# the scraper rewrites it to https:// internally (see apps/scraper/app/config.py
# for why: the sync Python client hangs over the websocket/hrana transport).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth --------------------------------------------------------------
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- LLM extraction ----------------------------------------------------
# Best structured extraction: strict, provider-enforced JSON schema.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only if OPENAI_API_KEY is unset. Any OpenAI-compatible chat endpoint
# that supports at least `response_format: {"type": "json_object"}` (most
# do, even if they don't support strict json_schema outputs). Extractions
# from this path are capped at the same confidence ceiling as the heuristic
# extractor, since the schema isn't provider-enforced.
LLM_COMPAT_API_KEY=
LLM_COMPAT_BASE_URL=https://api.novita.ai/openai
LLM_COMPAT_MODEL=deepseek/deepseek-v4-flash

# If neither key above is set, extraction falls back to a conservative
# heuristic (regex-based) extractor with lower confidence — everything still
# runs end to end, just with fewer fields populated.

# --- Search providers ----------------------------------------------------
# Primary discovery search provider.
TAVILY_API_KEY=
# Backup search provider, used automatically if Tavily fails or is unset.
SERPAPI_API_KEY=

# --- Scraper service auth ----------------------------------------------
# Shared secret required in the X-API-Key header to call scraper endpoints.
SCRAPER_API_SECRET=

# --- Optional ------------------------------------------------------------
SENTRY_DSN=
